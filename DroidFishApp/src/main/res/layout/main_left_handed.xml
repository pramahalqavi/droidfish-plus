<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginRight="2dp"
            android:layout_weight="1"
            android:layout_width="0dip"
            android:layout_height="fill_parent"
            android:paddingRight="1dp">

            <include
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                layout="@layout/title" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/badge_pill_bg"
                android:gravity="center_vertical"
                android:includeFontPadding="true"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <view
                class="org.petero.droidfish.view.EvaluationBarView"
                android:id="@+id/evaluationBar"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="2dp"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:tag="m3_card">

                <view
                    class="org.petero.droidfish.view.MyRelativeLayout"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ScrollView
                        android:id="@+id/scrollView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <view
                            class="org.petero.droidfish.view.MoveListView"
                            android:id="@+id/moveList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="true"
                            android:padding="0dp" />
                    </ScrollView>

                    <view
                        class="org.petero.droidfish.view.MyScrollView"
                        android:id="@+id/scrollViewBot"
                        android:layout_alignParentBottom="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/md_theme_surfaceContainerHigh"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/thinking"
                            android:tag="thinking"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="true"
                            android:fontFamily="monospace"
                            android:typeface="monospace"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp" />
                    </view>
                </view>
            </com.google.android.material.card.MaterialCardView>

            <!-- Material 3 Navigation Bar (Anchored at very bottom) -->
            <LinearLayout
                android:id="@+id/buttons"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/navigation_bar_bg"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:tag="m3_ignore">

                <!-- 1. Redo -->
                <LinearLayout
                    android:id="@+id/redoItem"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:id="@+id/redoPill"
                        android:layout_width="64dp"
                        android:layout_height="32dp"
                        android:duplicateParentState="true"
                        android:background="@drawable/nav_indicator_pill">

                        <ImageButton
                            android:id="@+id/redoButton"
                            android:contentDescription="@string/buttonDesc_forward"
                            android:background="@null"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:clickable="false"
                            android:focusable="false" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/redoLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/nav_action_redo" />
                </LinearLayout>

                <!-- 2. Undo -->
                <LinearLayout
                    android:id="@+id/undoItem"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:id="@+id/undoPill"
                        android:layout_width="64dp"
                        android:layout_height="32dp"
                        android:duplicateParentState="true"
                        android:background="@drawable/nav_indicator_pill">

                        <ImageButton
                            android:id="@+id/undoButton"
                            android:contentDescription="@string/buttonDesc_back"
                            android:background="@null"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:clickable="false"
                            android:focusable="false" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/undoLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/nav_action_undo" />
                </LinearLayout>

                <!-- 3. Action / Custom 2 (Engine) -->
                <LinearLayout
                    android:id="@+id/custom2Item"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:id="@+id/custom2Pill"
                        android:layout_width="64dp"
                        android:layout_height="32dp"
                        android:duplicateParentState="true"
                        android:background="@drawable/nav_indicator_pill">

                        <ImageButton
                            android:id="@+id/custom2Button"
                            android:contentDescription="@string/buttonDesc_custom2"
                            android:background="@null"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:clickable="false"
                            android:focusable="false" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/custom2Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/nav_action_action" />
                </LinearLayout>

                <!-- 4. Mode -->
                <LinearLayout
                    android:id="@+id/modeItem"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:id="@+id/modePill"
                        android:layout_width="64dp"
                        android:layout_height="32dp"
                        android:duplicateParentState="true"
                        android:background="@drawable/nav_indicator_pill">

                        <ImageButton
                            android:id="@+id/modeButton"
                            android:contentDescription="@string/buttonDesc_mode"
                            android:background="@null"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:clickable="false"
                            android:focusable="false" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/modeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/nav_action_mode" />
                </LinearLayout>

                <!-- 5. Flip / Custom 1 -->
                <LinearLayout
                    android:id="@+id/custom1Item"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:id="@+id/custom1Pill"
                        android:layout_width="64dp"
                        android:layout_height="32dp"
                        android:duplicateParentState="true"
                        android:background="@drawable/nav_indicator_pill">

                        <ImageButton
                            android:id="@+id/custom1Button"
                            android:contentDescription="@string/buttonDesc_custom1"
                            android:background="@null"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:clickable="false"
                            android:focusable="false" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/custom1Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/nav_action_flip" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <view
            class="org.petero.droidfish.ChessBoardPlay"
            android:id="@+id/chessboard"
            android:layout_weight="0"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
    </LinearLayout>

    <include layout="@layout/left_drawer" />

    <include layout="@layout/right_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
